# Copy this file to .env and fill in real values there.
# .env is gitignored - it will never be committed. This file (.env.example)
# has no real secrets in it and is safe to commit, so the required variables
# stay documented for anyone setting the project up.

# Required for signed login sessions to be secure. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Without this set, the app falls back to an insecure development default
# and prints a warning on startup - fine for local testing, not for anything
# reachable by others.
JWT_SECRET_KEY=

# Optional. If set, the General Document Comparison feature's AI summary
# uses Gemini (free tier) for higher-quality synthesis, including
# contradiction detection. Get a key at https://aistudio.google.com/apikey
# If unset, that feature automatically falls back to a local, free,
# zero-config model (google/flan-t5-base) - the app works fine either way.
GEMINI_API_KEY=

# Optional, only relevant if GEMINI_API_KEY is set. Overrides the default
# Gemini model used for that feature.
# GEMINI_MODEL=gemini-2.5-flash

# OCR fallback for scanned/image-only PDF pages (app/ingestion/generic_extractor.py).
# Requires the Tesseract OCR engine to be installed separately (it's a system
# program, not a Python package) - on Windows: winget install UB-Mannheim.TesseractOCR
# On Debian/Ubuntu (e.g. a Docker deploy): apt-get install tesseract-ocr tesseract-ocr-spa
# (that apt package already puts everything on the default PATH/tessdata dir,
# so none of these three variables need setting there.)

# Only needed if tesseract.exe isn't on your PATH (common on Windows).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Only needed if you're using a tessdata folder other than the one bundled
# with your Tesseract install (e.g. to add a language pack without admin
# rights to Program Files).
# TESSDATA_PREFIX=D:\UOG Assignments\MSC PROJECT\Code\tessdata

# Which trained language packs Tesseract should try, in order. Defaults to
# "eng+spa" to match this project's English/Spanish multilingual test docs.
# OCR_LANGUAGES=eng+spa
